# Copy to .env.local and fill in. Never commit .env.local.
# Add the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude Console → API keys
ANTHROPIC_API_KEY=
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# Recruiter access gate (pick a passcode you will type on stage)
RECRUITER_PASSCODE=
# openssl rand -base64 32
SESSION_SECRET=
# openssl rand -base64 32  (must decode to exactly 32 bytes)
TOKEN_ENC_KEY=

# App
APP_URL=http://localhost:3000
DEMO_MODE=true
# Minutes before an unstarted invitation becomes a follow-up task (use 2 for the demo)
TASK_OVERDUE_MINUTES=2

# Demo identity: your own email and WhatsApp number become one demo candidate's contact details
DEMO_CANDIDATE_EMAIL=
# International format, digits only, no + (example: 919812345678)
DEMO_CANDIDATE_WHATSAPP=

# Optional email delivery (without a verified domain, Resend only delivers to your own account email)
RESEND_API_KEY=
EMAIL_FROM=Rekrutly <onboarding@resend.dev>
