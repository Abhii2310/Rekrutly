# Copy to .env.local and fill in. Never commit .env.local.
# Add the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (all model access goes through lib/ai/client.ts)
AI_PROVIDER=google            # gateway | google | anthropic | groq
AI_FALLBACK_PROVIDER=         # optional backup, must differ from AI_PROVIDER
AI_GATEWAY_API_KEY=           # Vercel Dashboard → AI Gateway → API Keys
GOOGLE_GENERATIVE_AI_API_KEY= # aistudio.google.com → Get API key (free tier: demo data only)
ANTHROPIC_API_KEY=            # only if AI_PROVIDER=anthropic
GROQ_API_KEY=                 # console.groq.com → API Keys (free tier works well as a fallback)
AI_MODEL_SMART=               # filled after npm run ai:check
AI_MODEL_FAST=
AI_FALLBACK_MODEL=

# Recruiter access gate (pick a passcode you will type on stage)
RECRUITER_PASSCODE=
# openssl rand -base64 32
SESSION_SECRET=
# openssl rand -base64 32  (must decode to exactly 32 bytes)
TOKEN_ENC_KEY=

# App
APP_URL=http://localhost:3000
DEMO_MODE=true
# Demo value (2). The app defaults to 60 when unset.
TASK_OVERDUE_MINUTES=2

# Demo identity: your own email and WhatsApp number become one demo candidate's contact details
DEMO_CANDIDATE_EMAIL=
# International format, digits only, no + (example: 919812345678)
DEMO_CANDIDATE_WHATSAPP=

# Optional email delivery (without a verified domain, Resend only delivers to your own account email)
RESEND_API_KEY=
EMAIL_FROM=Rekrutly <onboarding@resend.dev>
# Better: send from your own Gmail to anyone. Turn on 2-Step Verification, then create an app password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: lets a scheduler (for example cron-job.org every 10 minutes) call /api/cron/reminders with this secret.
CRON_SECRET=

# The app is open to anyone with the link. Set this to true to ask for RECRUITER_PASSCODE again.
REQUIRE_PASSCODE=
